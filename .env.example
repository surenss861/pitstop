# Square (server-side only — never commit .env or .env.local)
# Get these from: Square Developer Console → your app → Credentials & Locations
# Use Sandbox for testing, Production for live. Rotate tokens if ever exposed.

SQUARE_APPLICATION_ID=your_application_id
SQUARE_ACCESS_TOKEN=your_access_token
SQUARE_LOCATION_ID=your_location_id

# Public booking page (safe to expose; used for "Book Now" links)
# From Square Appointments → enable online booking → copy booking URL
NEXT_PUBLIC_BOOKING_URL=https://app.squareup.com/appointments/book/your_app_id/your_location_id/start

# Quote form (server-side only)
# Resend: https://resend.com/api-keys — use a verified domain for QUOTE_FROM_EMAIL in production
RESEND_API_KEY=re_your_api_key
QUOTE_NOTIFY_EMAIL=your_email@example.com
# Optional: sender address (defaults to onboarding@resend.dev for testing)
# QUOTE_FROM_EMAIL=PitStop Polish <quotes@yourdomain.com>
